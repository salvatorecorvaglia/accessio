{
  "name": "accessio",
  "version": "3.2.0",
  "description": "Fast, flexible, zero-dependency modern HTTP client for JS/TS",
  "type": "module",
  "main": "./cjs/index.cjs",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js",
      "require": "./cjs/index.cjs"
    },
    "./helpers/rateLimiter": {
      "types": "./esm/helpers/rateLimiter.d.ts",
      "import": "./esm/helpers/rateLimiter.js",
      "require": "./cjs/helpers/rateLimiter.cjs"
    },
    "./helpers/debug": {
      "types": "./esm/helpers/debug.d.ts",
      "import": "./esm/helpers/debug.js",
      "require": "./cjs/helpers/debug.cjs"
    },
    "./core/buildURL": {
      "types": "./esm/core/buildURL.d.ts",
      "import": "./esm/core/buildURL.js",
      "require": "./cjs/core/buildURL.cjs"
    },
    "./core/mergeConfig": {
      "types": "./esm/core/mergeConfig.d.ts",
      "import": "./esm/core/mergeConfig.js",
      "require": "./cjs/core/mergeConfig.cjs"
    },
    "./core/request": {
      "types": "./esm/core/request.d.ts",
      "import": "./esm/core/request.js",
      "require": "./cjs/core/request.cjs"
    },
    "./core/retry": {
      "types": "./esm/core/retry.d.ts",
      "import": "./esm/core/retry.js",
      "require": "./cjs/core/retry.cjs"
    },
    "./helpers/parseHeaders": {
      "types": "./esm/helpers/parseHeaders.d.ts",
      "import": "./esm/helpers/parseHeaders.js",
      "require": "./cjs/helpers/parseHeaders.cjs"
    },
    "./helpers/settle": {
      "types": "./esm/helpers/settle.d.ts",
      "import": "./esm/helpers/settle.js",
      "require": "./cjs/helpers/settle.cjs"
    },
    "./helpers/transformData": {
      "types": "./esm/helpers/transformData.d.ts",
      "import": "./esm/helpers/transformData.js",
      "require": "./cjs/helpers/transformData.cjs"
    }
  },
  "files": [
    "src/",
    "cjs/",
    "esm/",
    "index.d.ts"
  ],
  "scripts": {
    "build:cjs": "tsup",
    "build": "pnpm run build:cjs",
    "prepublishOnly": "pnpm run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "release:npm": "gh workflow run publish-npm.yml -f publish_tag=$(git describe --tags --abbrev=0)",
    "typecheck": "tsc --noEmit"
  },
  "author": "salvatorecorvaglia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salvatorecorvaglia/accessio.git"
  },
  "bugs": {
    "url": "https://github.com/salvatorecorvaglia/accessio/issues"
  },
  "homepage": "https://github.com/salvatorecorvaglia/accessio",
  "sideEffects": false,
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
