{
  "name": "accessio",
  "version": "4.0.0",
  "description": "Fast, flexible, zero-dependency modern HTTP client for JS/TS",
  "type": "module",
  "main": "./cjs/index.cjs",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "author": "salvatorecorvaglia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salvatorecorvaglia/accessio.git"
  },
  "bugs": {
    "url": "https://github.com/salvatorecorvaglia/accessio/issues"
  },
  "homepage": "https://github.com/salvatorecorvaglia/accessio",
  "sideEffects": false,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      },
      "require": {
        "types": "./cjs/index.d.cts",
        "default": "./cjs/index.cjs"
      }
    },
    "./helpers/rateLimiter": {
      "import": {
        "types": "./esm/helpers/rateLimiter.d.ts",
        "default": "./esm/helpers/rateLimiter.js"
      },
      "require": {
        "types": "./cjs/helpers/rateLimiter.d.cts",
        "default": "./cjs/helpers/rateLimiter.cjs"
      }
    },
    "./helpers/debug": {
      "import": {
        "types": "./esm/helpers/debug.d.ts",
        "default": "./esm/helpers/debug.js"
      },
      "require": {
        "types": "./cjs/helpers/debug.d.cts",
        "default": "./cjs/helpers/debug.cjs"
      }
    },
    "./core/buildURL": {
      "import": {
        "types": "./esm/core/buildURL.d.ts",
        "default": "./esm/core/buildURL.js"
      },
      "require": {
        "types": "./cjs/core/buildURL.d.cts",
        "default": "./cjs/core/buildURL.cjs"
      }
    },
    "./core/mergeConfig": {
      "import": {
        "types": "./esm/core/mergeConfig.d.ts",
        "default": "./esm/core/mergeConfig.js"
      },
      "require": {
        "types": "./cjs/core/mergeConfig.d.cts",
        "default": "./cjs/core/mergeConfig.cjs"
      }
    },
    "./core/request": {
      "import": {
        "types": "./esm/core/request.d.ts",
        "default": "./esm/core/request.js"
      },
      "require": {
        "types": "./cjs/core/request.d.cts",
        "default": "./cjs/core/request.cjs"
      }
    },
    "./core/retry": {
      "import": {
        "types": "./esm/core/retry.d.ts",
        "default": "./esm/core/retry.js"
      },
      "require": {
        "types": "./cjs/core/retry.d.cts",
        "default": "./cjs/core/retry.cjs"
      }
    },
    "./helpers/parseHeaders": {
      "import": {
        "types": "./esm/helpers/parseHeaders.d.ts",
        "default": "./esm/helpers/parseHeaders.js"
      },
      "require": {
        "types": "./cjs/helpers/parseHeaders.d.cts",
        "default": "./cjs/helpers/parseHeaders.cjs"
      }
    },
    "./helpers/settle": {
      "import": {
        "types": "./esm/helpers/settle.d.ts",
        "default": "./esm/helpers/settle.js"
      },
      "require": {
        "types": "./cjs/helpers/settle.d.cts",
        "default": "./cjs/helpers/settle.cjs"
      }
    },
    "./helpers/transformData": {
      "import": {
        "types": "./esm/helpers/transformData.d.ts",
        "default": "./esm/helpers/transformData.js"
      },
      "require": {
        "types": "./cjs/helpers/transformData.d.cts",
        "default": "./cjs/helpers/transformData.cjs"
      }
    }
  },
  "files": [
    "src/",
    "cjs/",
    "esm/"
  ],
  "scripts": {
    "build:cjs": "tsup",
    "build": "pnpm run build:cjs",
    "prepublishOnly": "pnpm run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "release:npm": "gh workflow run publish-npm.yml -f publish_tag=$(git describe --tags --abbrev=0)",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
